for i = 1, 5 do
  if i % 2 == 0 then continue end
  print(i)                      ## 1 3 5
end

local i = 0
while i < 5 do
  i += 1
  if i == 3 then continue end
  print(i)                      ## 1 2 4 5
end

for i = 1, 3 do                 ## nested: continue hits the inner loop only
  for j = 1, 3 do
    if j == 2 then continue end
    print(i, j)
  end
end

local fns = {}
for i = 1, 3 do                 ## closures: upvalues must still close
  local v = i * 10
  if i == 2 then continue end
  fns[#fns + 1] = function() return v end
end
print(fns[1](), fns[2]())       ## 10 30

## continue in repeat-until (should work, or give the "jumps into scope" error)
local i = 0
repeat
  i += 1
  if i == 2 then
    continue
  end
  print(i)
until i >= 4

## continue inside a nested block inside a loop
for i = 1, 3 do
  do
    if i == 2 then continue end
  end
  print(i)
end

## generic for
for k, v in pairs({10, 20, 30}) do
  if v == 20 then continue end
  print(k, v)
end

## continue as an error outside a loop (check the message)
## continue

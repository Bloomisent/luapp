assert((nil ?? 5) == 5)
assert((false ?? 5) == false)
assert((0 ?? 5) == 0)

local calls = 0
local function f() calls += 1; return 9 end
assert((1 ?? f()) == 1 and calls == 0)   ## short circuit
assert((nil ?? nil ?? 3) == 3)

local v = nil
assert((v ?? "d") == "d" and v == nil)   ## local not clobbered

local t = {}
assert((t.x ?? t.y ?? 7) == 7)
assert((nil ?? (nil and 1) ?? 2) == 2)
print(t, calls);

local a = 14
local o = nil
local x = (o ?? a)

print("O: "..tostring(o), "A: "..tostring(a), "X: "..tostring(x));

local s = nil;
## s ??= 5; ## make this work in the future

print(s);
